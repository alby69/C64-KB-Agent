{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/alby69/C64-KB-Agent/schemas/document.schema.json",
  "title": "C64 Knowledge Document",
  "description": "Contratto dati per i documenti Markdown con frontmatter YAML prodotti da C64-Scrapy e indicizzati da C64-KB-Agent. Versione schema: 1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Versione del contratto dati. Assente => assume 1."
    },
    "title": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "category": {
      "type": "string",
      "enum": ["reference", "tutorial", "manual", "tool", "source-code", "deep-dive"]
    },
    "topics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "language": {
      "type": "string",
      "enum": ["assembly", "basic", "mixed", "none"]
    },
    "hardware": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scraped_at": { "type": "string", "format": "date" }
  },
  "required": [
    "title", "source_url", "category", "topics",
    "difficulty", "language", "hardware", "related", "scraped_at"
  ],
  "additionalProperties": true
}
